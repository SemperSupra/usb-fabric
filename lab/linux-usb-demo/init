#!/bin/sh
set -eu
/bin/busybox --install -s /bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
say() { printf '%s\n' "$*" | tee /dev/tty0; }
for f in /modules/*.ko; do
    [ -f "$f" ] || continue
    insmod "$f" || { say "GUEST_MODULE_LOAD_FAILED"; exec sh; }
done
clear >/dev/tty0 || true
say "USB FABRIC / LINUX GUEST EVALUATION"
say "==================================="
say "Actual Linux sysfs and evdev observations"
say ""
i=0
event=""
while [ "$i" -lt 45 ]; do
    for n in /sys/class/input/event*/device/name; do
        [ -r "$n" ] || continue
        case "$(cat "$n")" in
            *QEMU*Keyboard*) event="/dev/input/$(basename "$(dirname "$(dirname "$n")")")"; break ;;
        esac
    done
    [ -n "$event" ] && [ -c "$event" ] && break
    i=$((i+1))
    sleep 1
done
[ -n "$event" ] && [ -c "$event" ] || { say "GUEST_KEYBOARD_MISSING"; exec sh; }
# Independently observe each device and its actual USB interface driver.
bound_device() {
    target="$1"
    count=0
    for d in /sys/bus/usb/devices/*; do
        [ -r "$d/idVendor" ] && [ -r "$d/idProduct" ] || continue
        [ "$(cat "$d/idVendor")" = "0627" ] || continue
        [ "$(cat "$d/idProduct")" = "$target" ] || continue
        for interface in "$d":*; do
            [ -L "$interface/driver" ] || continue
            [ "$(basename "$(readlink "$interface/driver")")" = "usbhid" ] || continue
            count=$((count+1))
        done
    done
    [ "$count" -eq 1 ]
}
i=0
until bound_device 0001 && bound_device 0002; do
    i=$((i+1))
    [ "$i" -lt 45 ] || { say "GUEST_USB_HID_BINDING_FAILED"; exec sh; }
    sleep 1
done
say "USB 0627:0001 keyboard usbhid"
say "USB 0627:0002 tablet usbhid"
say "GUEST_USB_KEYBOARD_ENUMERATED=PASS"
say "GUEST_USB_KEYBOARD_DRIVER_BOUND=PASS"
say "GUEST_USB_TABLET_ENUMERATED=PASS"
say "GUEST_USB_TABLET_DRIVER_BOUND=PASS"
say "Waiting for host QMP input..."
/bin/observe "$event" | tee /dev/tty0
# The observer supplies its own ordered down/up markers. A failure cannot forge them.
say "GUEST_OBSERVER_EXIT"
while :; do sleep 60; done
